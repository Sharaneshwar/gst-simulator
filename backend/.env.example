# Keep real credentials in backend/.env, never in frontend code or Git.
DATABASE_URL=postgresql://user:password@your-neon-pooler-host/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://user:password@your-neon-host/neondb?sslmode=verify-full
SMTP_USER=your-email@gmail.com
SMTP_PASS=
# Gmail SMTP defaults (optional overrides for another mail provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Use a strong private value in deployments; also used to protect OTP hashes.
TOKEN_SECRET=
OTP_SECRET=
